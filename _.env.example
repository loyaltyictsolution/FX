# Required (set as secrets on your host, never commit real values)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...paste the whole JSON key on one line...}

# Optional
DATABASE_URL=https://loyalty-fx-default-rtdb.firebaseio.com
DATA_KEY=            # Twelve Data key; if empty it is read from the app's saved settings
WATCH=               # e.g. EUR/USD,GBP/USD,USD/JPY ; if empty it uses the app's tracked markets
THRESHOLD=0.6
