{
  "rules": {
    ".read": false,
    ".write": false,
    "fcmTokens": { "$uid": { ".write": "auth != null && auth.uid === $uid", "$k": { ".validate": "newData.isString() && newData.val().length < 400" } } },
    "admins": { "$uid": { ".read": "auth != null && auth.uid === $uid" } },
    "signals":   { ".read": "auth != null" },
    "alerts":    { ".read": "auth != null", ".indexOn": ["ts"] },
    "heartbeat": { ".read": "auth != null" },
    "status":    { ".read": "auth != null" },
    "config": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).val() === true",
      "threshold": { ".validate": "newData.isNumber() && newData.val() >= 0.5 && newData.val() <= 0.9" },
      "paused":    { ".validate": "newData.isBoolean()" },
      "$other":    { ".validate": false }
    },
    "commands": {
      "$id": {
        ".write": "root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['type','ts','by']) && newData.child('type').val().matches(/^(refresh|retrain)$/)"
      }
    }
  }
}
