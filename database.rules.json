{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": { "$uid": { ".read": "auth != null && auth.uid === $uid" } },
    "settings": {
      ".read": "root.child('admins').child(auth.uid).val() === true",
      ".write": "root.child('admins').child(auth.uid).val() === true",
      "dataKey":   { ".validate": "newData.isString() && newData.val().length < 200" },
      "threshold": { ".validate": "newData.isNumber() && newData.val() >= 0.4 && newData.val() <= 0.9" },
      "$other":    { ".validate": false }
    }
  }
}
